# CanvAssist Backend — Production Environment Variables
# Copy this file to .env and fill in your values.

# --- Database ---
# Use PostgreSQL in production (recommended) or leave as SQLite for single-server deployments.
# DATABASE_URL=postgresql://canvassist:STRONG_PASSWORD@localhost:5432/canvassist
DATABASE_URL=sqlite:///./canvas_better.db

# --- Canvas ---
# Base URL of your Canvas institution (no trailing slash).
CANVAS_BASE_URL=https://northeastern.instructure.com

# --- Frontend URL ---
# Base URL used when building password reset links.
# For local dev: http://localhost:5173
# For prod: https://canvassist.com
FRONTEND_BASE_URL=https://canvassist.com

# --- Security ---
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# REQUIRED in production — do NOT leave blank or regenerate after first run (tokens will become unreadable).
TOKEN_ENCRYPTION_KEY=REPLACE_ME

# --- CORS ---
# Comma-separated list of allowed frontend origins.
ALLOWED_ORIGINS=https://canvassist.com,https://www.canvassist.com

# --- Cookies ---
# Set to "true" when serving over HTTPS (required for production).
SECURE_COOKIES=true

# --- Email / Password Reset ---
# If SMTP_HOST is not set, forgot-password still returns success,
# but reset links are only logged server-side (dev fallback).
#
# Common values:
# - SMTP_PORT=587 with SMTP_USE_TLS=true
# - SMTP_PORT=465 with SMTP_USE_TLS=false (implicit TLS is not currently used in code)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your_smtp_username
SMTP_PASSWORD=your_smtp_password
SMTP_USE_TLS=true

# Sender address shown in the reset email.
# For AWS SES, this must be a verified identity (email or domain) in the same AWS region.
# If your SES account is still in sandbox, the recipient address must also be verified.
MAIL_FROM=no-reply@canvassist.com

# --- Cache ---
CACHE_TTL_SECONDS=600
SYNC_INTERVAL_SECONDS=180
