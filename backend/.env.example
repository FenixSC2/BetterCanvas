# CanvAssist Backend — Production Environment Variables
# Copy this file to .env and fill in your values.

# --- Database ---
# Use PostgreSQL in production (recommended) or leave as SQLite for single-server deployments.
# DATABASE_URL=postgresql://canvassist:STRONG_PASSWORD@localhost:5432/canvassist
DATABASE_URL=sqlite:///./canvas_better.db

# --- Canvas ---
# Base URL of your Canvas institution (no trailing slash).
CANVAS_BASE_URL=https://northeastern.instructure.com

# --- Security ---
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# REQUIRED in production — do NOT leave blank or regenerate after first run (tokens will become unreadable).
TOKEN_ENCRYPTION_KEY=REPLACE_ME

# --- CORS ---
# Comma-separated list of allowed frontend origins.
ALLOWED_ORIGINS=https://canvassist.com,https://www.canvassist.com

# --- Cookies ---
# Set to "true" when serving over HTTPS (required for production).
SECURE_COOKIES=true

# --- Cache ---
CACHE_TTL_SECONDS=600
SYNC_INTERVAL_SECONDS=180
